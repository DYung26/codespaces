#!/usr/bin/env bash
# Burst-compute runner for GitHub Codespaces. Requires gh, git, tar, and bash.
set -Eeuo pipefail

DEFAULT_REPO="${CS_BURST_REPO:-DYung26/codespaces-burst}"
DEFAULT_MACHINE="${CS_BURST_MACHINE:-basicLinux32gb}"
DEFAULT_IDLE="${CS_BURST_IDLE_TIMEOUT:-5m}"
DEFAULT_RETENTION="${CS_BURST_RETENTION:-1d}"
TMP_BASE="${TMPDIR:-/tmp}"

die() { printf 'cs-burst: %s\n' "$*" >&2; exit 2; }
note() { printf 'cs-burst: %s\n' "$*" >&2; }
need() { command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"; }

usage() {
  cat <<'EOF'
Usage:
  cs-burst run --repo OWNER/REPO [--account ALIAS] [--machine NAME] -- COMMAND [ARG...]
  cs-burst status [--account ALIAS]
  cs-burst accounts
  cs-burst cleanup [--account ALIAS] [--repo OWNER/REPO] [--older-than DAYS]
  cs-burst help

A run creates a short-lived Codespace from the dedicated default-image launcher,
copies a sanitized snapshot of the current directory, executes the command in
/tmp/cs-burst-job, collects logs/artifacts into ./artifacts/, and deletes the
Codespace when done.

Options:
  --repo OWNER/REPO     Project repo for access validation/context (required)
  --account ALIAS       gh alias: gh-26, gh-06, gh-df, gh-odo, gh-do
  --machine NAME        Machine type (default: $DEFAULT_MACHINE)
  --launcher OWNER/REPO Burst launcher (default: $DEFAULT_REPO)
  --idle-timeout VALUE  Idle timeout (default: $DEFAULT_IDLE)
  --retention VALUE     Stopped retention (default: $DEFAULT_RETENTION)
  --workdir PATH        Local project checkout (default: current directory)
  --keep                Stop but do not delete worker (storage still bills)
  --no-artifacts        Skip result collection
  --env-file PATH       Explicit env file transfer (avoid secrets)
  --dry-run             Print plan without creating resources
  --help                Show this help

The worker never commits or pushes. Project-specific skills own build/deploy
commands. Remote changes remain temporary; only returned artifacts persist.
EOF
}

set_account() {
  case "${1:-}" in
    gh-26|gh-06|gh-df|gh-odo|gh-do) export CS_BURST_ACCOUNT="$1" ;;
    *) die "unknown account alias '$1' (use gh-26, gh-06, gh-df, gh-odo, gh-do)" ;;
  esac
}

ghx() {
  case "${CS_BURST_ACCOUNT:-}" in
    "") command gh "$@" ;;
    gh-26) GH_CONFIG_DIR="$HOME/.config/gh-dyung26" command gh "$@" ;;
    gh-06) GH_CONFIG_DIR="$HOME/.config/gh-dyung06" command gh "$@" ;;
    gh-df) GH_CONFIG_DIR="$HOME/.config/gh-dyungfirm" command gh "$@" ;;
    gh-odo) GH_CONFIG_DIR="$HOME/.config/gh-oyedanolu" command gh "$@" ;;
    gh-do) GH_CONFIG_DIR="$HOME/.config/gh-danieloyekunle" command gh "$@" ;;
    *) die "invalid account alias" ;;
  esac
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  help|-h|--help) usage; exit 0 ;;
  accounts)
    for a in gh-26 gh-06 gh-df gh-odo gh-do; do
      printf '\n[%s]\n' "$a"
      (CS_BURST_ACCOUNT="$a"; export CS_BURST_ACCOUNT; ghx auth status 2>&1 | sed -n '1,6p') || true
    done
    exit 0 ;;
  status)
    while (($#)); do
      case "$1" in --account) shift; set_account "${1:-}"; shift ;; *) die "unknown status option $1" ;; esac
    done
    ghx codespace list --json name,repository,state,machine,createdAt,updatedAt,retentionPeriod
    exit $? ;;
  cleanup)
    repo="$DEFAULT_REPO"; days=0
    while (($#)); do
      case "$1" in
        --account) shift; set_account "${1:-}"; shift ;;
        --repo) repo="${2:?missing repo}"; shift 2 ;;
        --older-than) days="${2:?missing days}"; shift 2 ;;
        *) die "unknown cleanup option $1" ;;
      esac
    done
    [[ "$days" =~ ^[0-9]+$ ]] || die "--older-than must be a non-negative integer"
    note "Selecting old codespaces under $repo. Review GitHub's prompt before deletion."
    ghx codespace delete --repo "$repo" --days "$days"
    exit $? ;;
  run) ;;
  *) die "unknown command '$cmd'; run 'cs-burst help'" ;;
esac

repo=""; launcher="$DEFAULT_REPO"; machine="$DEFAULT_MACHINE"; idle="$DEFAULT_IDLE"; retention="$DEFAULT_RETENTION"
workdir="$PWD"; keep=0; no_artifacts=0; dry=0; env_file=""
while (($#)); do
  case "$1" in
    --repo) repo="${2:?missing OWNER/REPO}"; shift 2 ;;
    --launcher) launcher="${2:?missing OWNER/REPO}"; shift 2 ;;
    --machine) machine="${2:?missing machine}"; shift 2 ;;
    --idle-timeout) idle="${2:?missing timeout}"; shift 2 ;;
    --retention) retention="${2:?missing retention}"; shift 2 ;;
    --workdir) workdir="${2:?missing workdir}"; shift 2 ;;
    --account) shift; set_account "${1:-}"; shift ;;
    --keep) keep=1; shift ;;
    --no-artifacts) no_artifacts=1; shift ;;
    --env-file) env_file="${2:?missing path}"; shift 2 ;;
    --dry-run) dry=1; shift ;;
    --) shift; break ;;
    *) die "unknown run option '$1'; put remote command after --" ;;
  esac
done
(($#)) || die "remote command required after --"
[[ "$repo" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || die "--repo must be OWNER/REPO"
[[ "$launcher" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || die "--launcher must be OWNER/REPO"
[[ -d "$workdir" ]] || die "workdir does not exist: $workdir"
[[ -z "$env_file" || -f "$env_file" ]] || die "env file not found"
workdir="$(cd "$workdir" && pwd -P)"
if ((dry)); then
  printf 'Account=%s\nLauncher=%s\nRepo=%s\nMachine=%s\nIdle=%s\nRetention=%s\nWorkdir=%s\nCommand=' "${CS_BURST_ACCOUNT:-default}" "$launcher" "$repo" "$machine" "$idle" "$retention" "$workdir"
  printf ' %q' "$@"; printf '\n'; exit 0
fi

need gh; need tar; need date
ghx auth status >/dev/null 2>&1 || die "selected gh profile is not authenticated; run gh auth login for it"
ghx repo view "$launcher" --json nameWithOwner >/dev/null || die "cannot access launcher $launcher"
ghx repo view "$repo" --json nameWithOwner >/dev/null || die "cannot access project repo $repo"

stamp="$(date -u +%Y%m%dT%H%M%SZ)"
display="burst-$stamp"
cs_name=""
tmp="$(mktemp -d "$TMP_BASE/cs-burst.XXXXXX")"
out_dir="$workdir/artifacts/cs-burst-$stamp"
mkdir -p "$out_dir"
remote_rc=1
cleanup() {
  local rc=$?
  trap - EXIT INT TERM
  set +e
  if [[ -n "$cs_name" ]]; then
    note "Stopping $cs_name"
    ghx codespace stop -c "$cs_name" >/dev/null 2>&1
    if ((keep)); then
      note "Keeping stopped worker $cs_name; storage charges continue until deletion."
    else
      note "Deleting worker $cs_name"
      ghx codespace delete -c "$cs_name" -f >/dev/null 2>&1
    fi
  fi
  rm -rf "$tmp"
  note "Artifacts, if collected: $out_dir"
  exit "$rc"
}
trap cleanup EXIT INT TERM

archive="$tmp/worktree.tar.gz"
(
  cd "$workdir"
  tar -czf "$archive" \
    --exclude='./.git' --exclude='./node_modules' --exclude='./.venv' --exclude='./venv' \
    --exclude='./.next' --exclude='./dist' --exclude='./build' --exclude='./coverage' \
    --exclude='./.turbo' --exclude='./artifacts' --exclude='./.env' --exclude='./.env.*' \
    --exclude='./.devcontainer' --exclude='./.vscode' --exclude='./.idea' .
)

note "Creating temporary Codespace from default-image launcher $launcher"
cs_name="$(ghx codespace create --repo "$launcher" --machine "$machine" --idle-timeout "$idle" --retention-period "$retention" --display-name "$display" --json name -q .name)"
[[ -n "$cs_name" ]] || die "GitHub did not return a Codespace name"

# Encode the arbitrary argv into a shell array using printf %q, rather than
# interpolating caller strings into the remote shell's source code.
remote_script="$tmp/remote.sh"
{
  cat <<'REMOTE'
#!/usr/bin/env bash
set -Eeuo pipefail
mkdir -p /tmp/cs-burst-job
cd /tmp/cs-burst-job
tar -xzf /tmp/cs-burst-worktree.tar.gz
REMOTE
  if [[ -n "$env_file" ]]; then
    printf '%s\n' 'set -a; source /tmp/cs-burst.env; set +a'
  fi
  printf 'printf "project=%s\\n" %q > metadata.txt\n' "$repo"
  printf 'set +e\n'
  printf '('
  printf ' %q' "$@"
  printf ' ) 2>&1 | tee command.log\n'
  printf 'rc=${PIPESTATUS[0]}\n'
  printf 'printf "%%s\\n" "$rc" > exit-code.txt\n'
  printf 'tar -czf /tmp/cs-burst-results.tar.gz command.log exit-code.txt metadata.txt\n'
  printf 'tar -czf /tmp/cs-burst-artifacts.tar.gz --exclude="./.git" --exclude="./node_modules" . 2>/dev/null || true\n'
  printf 'exit "$rc"\n'
} > "$remote_script"

ghx codespace cp "$archive" "remote:/tmp/cs-burst-worktree.tar.gz" -c "$cs_name"
ghx codespace cp "$remote_script" "remote:/tmp/cs-burst-command.sh" -c "$cs_name"
if [[ -n "$env_file" ]]; then ghx codespace cp "$env_file" "remote:/tmp/cs-burst.env" -c "$cs_name"; fi

set +e
ghx codespace ssh -c "$cs_name" -- "bash /tmp/cs-burst-command.sh"
remote_rc=$?
set -e
printf '%s\n' "$remote_rc" > "$out_dir/local-ssh-exit-code.txt"

if ((!no_artifacts)); then
  set +e
  ghx codespace cp -c "$cs_name" "remote:/tmp/cs-burst-results.tar.gz" "$out_dir/remote-results.tar.gz"
  result_copy=$?
  ghx codespace cp -c "$cs_name" "remote:/tmp/cs-burst-artifacts.tar.gz" "$out_dir/remote-artifacts.tar.gz"
  artifact_copy=$?
  set -e
  if ((result_copy == 0)); then tar -xzf "$out_dir/remote-results.tar.gz" -C "$out_dir" || true; fi
  if ((artifact_copy == 0)); then mkdir -p "$out_dir/project-output"; tar -xzf "$out_dir/remote-artifacts.tar.gz" -C "$out_dir/project-output" || true; fi
  ((result_copy == 0 || artifact_copy == 0)) || note "Warning: failed to download result archives."
fi
exit "$remote_rc"
